{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readable",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "images": {
    "binding": "IMAGES",
  },
  "services": [
    {
      // Self-reference binding required by OpenNext for edge caching.
      // The service name must match the worker name above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "readable",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // ---------------------------------------------------------------------------
  // Public vars — safe to commit. Secrets (MONGODB_URI, CLERK_SECRET_KEY) are
  // stored in Cloudflare dashboard / set via `wrangler secret put`.
  // ---------------------------------------------------------------------------
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://readable.ashwinsathian.com",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-Q8YDP8LXZ3",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuYXNod2luc2F0aGlhbi5jb20k",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": "/app",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL": "/",
  },
}
