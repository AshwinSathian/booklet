#!/usr/bin/env bash
# Pre-push hook: rebuilds and restarts the self-hosted Booklet server
# whenever a push targets the main branch.
#
# Skip this hook:  git push --no-verify
# Run manually:    bash scripts/redeploy.sh
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Production runs on Node 24 (see .nvmrc). Put that install first on PATH so
# npm, the build and anything PM2 spawns all use it, whatever Node the
# calling shell has active.
NODE_BIN="$HOME/.nvm/versions/node/v24.19.0/bin"
if [[ ! -x "$NODE_BIN/node" ]]; then
  echo "Node 24 not found at $NODE_BIN. Install it (nvm install 24.19.0) or update NODE_BIN here, in scripts/redeploy.sh, scripts/pm2-startup.sh, .githooks/pre-push and ecosystem.config.js." >&2
  exit 1
fi
export PATH="$NODE_BIN:$PATH"

# ── Make sure `pm2` is actually resolvable ────────────────────────────────────
source "$REPO_ROOT/scripts/lib/pm2-path.sh"

# ── Determine whether we're pushing to main ──────────────────────────────────
PUSH_TO_MAIN=false

while IFS=' ' read -r local_ref _local_sha remote_ref _remote_sha; do
  # remote_ref is "refs/heads/main" when pushing to main
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    PUSH_TO_MAIN=true
    break
  fi
done

if [[ "$PUSH_TO_MAIN" != "true" ]]; then
  echo "[pre-push] Target is not main — skipping server redeploy."
  exit 0
fi

# ── Guard: only deploy if PM2 is actually managing the server ─────────────────
if ! pm2 jlist 2>/dev/null | grep -q '"booklet-app"'; then
  echo "[pre-push] PM2 does not have booklet-app — skipping redeploy."
  echo "           Run: pm2 start ecosystem.config.js  to initialise the server."
  exit 0
fi

# ── Redeploy ──────────────────────────────────────────────────────────────────
echo ""
echo "┌─────────────────────────────────────────────────────┐"
echo "│  pre-push → pushing to main → redeploying server…  │"
echo "└─────────────────────────────────────────────────────┘"
echo ""

# Exit 2 means the new build is live and healthy and a verify suite failed.
# Production already runs this commit, so cancelling the push would leave it
# serving code that origin/main does not have: let the push through, loudly.
# Exit 1 means the build was rolled back (or could not be): cancel the push.
status=0
bash "$REPO_ROOT/scripts/redeploy.sh" || status=$?

echo ""
if [[ "$status" -eq 2 ]]; then
  echo "[pre-push] The server runs this commit, and a verify suite FAILED (see above)."
  echo "           Proceeding with push so origin/main matches what is live."
  exit 0
fi
if [[ "$status" -ne 0 ]]; then
  echo "[pre-push] Deploy failed (exit $status). Push cancelled."
  exit "$status"
fi
echo "[pre-push] Server is up-to-date. Proceeding with push."
