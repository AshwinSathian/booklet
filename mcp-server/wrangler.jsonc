{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "booklet-spike-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [{ "binding": "APP", "service": "booklet-spike-app" }],
  "vars": { "BOOKLET_API_BASE": "https://booklet-spike-app.ashwinsathyan19.workers.dev" },
  "observability": { "enabled": true }
}
