{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readable-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Public vars — safe to commit. No secrets here.
    "READABLE_API_BASE": "https://readable.ashwinsathian.com",
    "MCP_SERVER_NAME": "readable",
    "MCP_SERVER_VERSION": "1.0.0"
  },
  // custom_domain automatically creates the DNS record and provisions TLS.
  // Zone is ashwinsathian.com (the actual DNS zone — not the subdomain).
  "routes": [
    {
      "pattern": "mcp.readable.ashwinsathian.com/*",
      "zone_name": "ashwinsathian.com"
    }
  ]
}
