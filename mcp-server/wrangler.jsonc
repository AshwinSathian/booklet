{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readable-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "READABLE_API_BASE": "https://readable.ashwinsathian.com",
    "MCP_SERVER_NAME": "readable",
    "MCP_SERVER_VERSION": "1.0.0"
  },
  "routes": [
    {
      "pattern": "mcp.readable.ashwinsathian.com/*",
      "zone_name": "readable.ashwinsathian.com"
    }
  ]
}
