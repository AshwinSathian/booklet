{
  "name": "booklet-vscode",
  "displayName": "Booklet",
  "description": "Publish Markdown to a beautifully formatted, shareable Booklet page — right from the editor",
  "version": "0.2.0",
  "publisher": "AshwinSathian",
  "icon": "images/icon.png",
  "license": "MIT",
  "homepage": "https://booklet.ashwinsathian.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshwinSathian/booklet.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/AshwinSathian/booklet/issues"
  },
  "author": {
    "name": "Ashwin Sathian",
    "email": "ashwinsathyan19@gmail.com"
  },
  "keywords": [
    "markdown",
    "publish",
    "share",
    "booklet",
    "docs",
    "preview"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "booklet.publish",
        "title": "Booklet: Publish Current File"
      },
      {
        "command": "booklet.publishSelection",
        "title": "Booklet: Publish Selection"
      },
      {
        "command": "booklet.setApiKey",
        "title": "Booklet: Set API Key"
      }
    ],
    "configuration": {
      "title": "Booklet",
      "properties": {
        "booklet.defaultVisibility": {
          "type": "string",
          "enum": [
            "public",
            "unlisted"
          ],
          "default": "unlisted",
          "description": "Default visibility for published pages"
        },
        "booklet.baseUrl": {
          "type": "string",
          "default": "https://booklet-api.ashwinsathian.com",
          "description": "Booklet API base URL"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "booklet-api-client": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
