{
  "name": "booklet-cli",
  "version": "1.0.2",
  "description": "Publish Markdown to a shareable URL from your terminal or CI pipeline",
  "bin": {
    "booklet": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "booklet-api-client": "^1.0.0",
    "commander": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": {
    "name": "Ashwin Sathian",
    "email": "ashwinsathyan19@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://booklet.ashwinsathian.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshwinSathian/booklet.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "booklet",
    "markdown",
    "publish",
    "publishing",
    "cli",
    "cli-tool",
    "documentation",
    "docs",
    "share",
    "static-site",
    "notes",
    "changelog",
    "release-notes",
    "readme"
  ]
}
