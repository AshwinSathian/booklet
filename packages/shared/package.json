{
  "name": "booklet-api-client",
  "version": "1.0.0",
  "description": "Typed request/response schemas and a thin fetch client for the Booklet /api/v1 REST surface",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": {
    "name": "Ashwin Sathian",
    "email": "ashwinsathyan19@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://booklet.ashwinsathian.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshwinSathian/booklet.git",
    "directory": "packages/shared"
  },
  "keywords": [
    "booklet",
    "api-client"
  ]
}
