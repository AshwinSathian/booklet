# MongoDB — required. Both anonymous and signed-in publish use this.
MONGODB_URI=mongodb://localhost:27017/booklet?retryWrites=true&w=majority

# Team-invite JWT signing — required. Dedicated secret for signing/verifying
# team-invite links (src/lib/invite-token.ts). Must be its own random value —
# do NOT reuse any other secret. Generate with:
#   openssl rand -base64 32
# If unset, invite creation and verification fail closed (no fallback).
INVITE_JWT_SECRET=

# Password-unlock cookie signing — required. Dedicated secret for signing/
# verifying the booklet_unlock_<pageId> cookie set by
# src/app/api/pages/[id]/unlock/route.ts after a correct password check
# (src/lib/unlock-token.ts). Must be its own random value — do NOT reuse
# INVITE_JWT_SECRET or any other secret. Generate with:
#   openssl rand -hex 32
# If unset, unlock tokens cannot be signed or verified — fails closed (no
# fallback), so every request to a locked page re-prompts for the password.
UNLOCK_TOKEN_SECRET=

# API key hashing pepper — required. Server-only HMAC key so
# api_keys.key_hash stays useless to an attacker even if the DB is
# exfiltrated (src/lib/api-key.ts). Must be its own random value — do NOT
# reuse INVITE_JWT_SECRET, UNLOCK_TOKEN_SECRET, or any other secret.
# Generate with:
#   openssl rand -hex 32
# If unset, API keys cannot be hashed or verified — fails closed (no
# fallback). NOTE: changing this value invalidates every previously-issued
# API key (they'll need to be regenerated).
API_KEY_PEPPER=

# Session-cookie signing — required. Dedicated pepper for hashing in-house
# auth session tokens (src/lib/auth/session-token.ts) before they're stored in
# the `sessions` collection — same fail-closed convention as API_KEY_PEPPER:
# do NOT reuse any other secret. Generate with:
#   openssl rand -hex 32
# If unset, sessions cannot be created or verified (fails closed) — every
# request is treated as signed-out.
SESSION_TOKEN_PEPPER=

# Password-reset token hashing — required for the forgot-password flow.
# Dedicated pepper for hashing reset tokens (src/lib/auth/password-reset-token.ts)
# before they're stored in the `password_reset_tokens` collection — same
# fail-closed convention as SESSION_TOKEN_PEPPER: do NOT reuse any other
# secret. Generate with:
#   openssl rand -hex 32
# If unset, reset tokens cannot be hashed or verified (fails closed).
PASSWORD_RESET_TOKEN_PEPPER=

# Transactional email (Resend) — required for the forgot-password flow.
# https://resend.com — free tier covers this product's expected volume.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Booklet <noreply@booklet.ashwinsathian.com>

# Account-claim link signing — required. Dedicated secret for the /claim
# flow (src/lib/auth/claim-token.ts): lets a user migrated from the old
# Clerk-based auth set their first password. Same fail-closed convention —
# do NOT reuse any other secret. Generate with:
#   openssl rand -base64 32
CLAIM_TOKEN_SECRET=

# Site URL — used for canonical URLs and OG tags (optional, defaults to production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Analytics — optional, leave blank to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin dashboard (/admin) — requires BOTH checks to pass (fails closed if
# either is unset/empty in production; both are bypassed in development).
# ADMIN_IPS: comma-separated client IPs allowed to reach /admin. Only the
#   Cloudflare-verified `cf-connecting-ip` header is trusted for this check —
#   see src/lib/request-ip.ts.
# ADMIN_USER_IDS: comma-separated user IDs (not emails) allowed to view
#   /admin once past the IP check — the `id` field on a `users` document.
ADMIN_IPS=
ADMIN_USER_IDS=
