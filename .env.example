# MongoDB Atlas — required. Both anonymous and signed-in publish use this.
# Get your connection string from https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb://localhost:27017/readable?retryWrites=true&w=majority

# Clerk — get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk route overrides (optional — these match the app's route structure)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk v7 redirect vars (v5 AFTER_SIGN_IN_URL / AFTER_SIGN_UP_URL are no longer read by Clerk v7)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Team-invite JWT signing — required. Dedicated secret for signing/verifying
# team-invite links (src/lib/invite-token.ts). Must be its own random value —
# do NOT reuse CLERK_SECRET_KEY or any other secret. Generate with:
#   openssl rand -base64 32
# If unset, invite creation and verification fail closed (no fallback).
INVITE_JWT_SECRET=

# Password-unlock cookie signing — required. Dedicated secret for signing/
# verifying the readable_unlock_<pageId> cookie set by
# src/app/api/pages/[id]/unlock/route.ts after a correct password check
# (src/lib/unlock-token.ts). Must be its own random value — do NOT reuse
# CLERK_SECRET_KEY, INVITE_JWT_SECRET, or any other secret. Generate with:
#   openssl rand -hex 32
# If unset, unlock tokens cannot be signed or verified — fails closed (no
# fallback), so every request to a locked page re-prompts for the password.
UNLOCK_TOKEN_SECRET=

# Site URL — used for canonical URLs and OG tags (optional, defaults to production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Analytics — optional, leave blank to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin dashboard (/admin) — requires BOTH checks to pass (fails closed if
# either is unset/empty in production; both are bypassed in development).
# ADMIN_IPS: comma-separated client IPs allowed to reach /admin. Only the
#   Cloudflare-verified `cf-connecting-ip` header is trusted for this check —
#   see src/lib/request-ip.ts.
# ADMIN_USER_IDS: comma-separated Clerk user IDs (not emails) allowed to view
#   /admin once past the IP check. Find your Clerk user ID in the Clerk
#   dashboard under Users.
ADMIN_IPS=
ADMIN_USER_IDS=
